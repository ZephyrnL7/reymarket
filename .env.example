NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# Supabase project settings. Never expose the service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_RECEIPTS_BUCKET=receipts-private
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

# Generate a random secret with at least 32 characters.
JWT_ACCESS_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=20m
REFRESH_TOKEN_DAYS=14

# Public payment instructions. Leave blank until your details are ready.
TNG_QR_IMAGE_URL=
MAYBANK_ACCOUNT_NAME=
MAYBANK_ACCOUNT_NUMBER=
